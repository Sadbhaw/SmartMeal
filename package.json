{
  "name": "smartmeal",
  "version": "0.1.0",
  "description": "AI-powered personalized meal planning application",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run dev --workspace=@smartmeal/api",
    "mobile": "npm run dev --workspace=@smartmeal/mobile",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "type-check": "npm run type-check --workspace=@smartmeal/api && npm run type-check --workspace=@smartmeal/mobile",
    "test": "npm run test --workspace=@smartmeal/api"
  }
}
